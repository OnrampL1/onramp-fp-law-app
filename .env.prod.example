# Template for the real .env.prod, which lives only on the VPS at
# /opt/clausio/app/.env.prod and is never committed (see .gitignore).
# Copy this file there and replace every placeholder before first use.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://clausio.wahabtlais.site
APP_URL=https://clausio.wahabtlais.site

# ─── Image tag ────────────────────────────────────────────────────────────────
# Set by Batch 5's CI/CD to a git SHA (always) or a semantic version (on a
# deliberate release). Never leave this as "latest" for a real deploy —
# that's the one thing the frozen architecture explicitly rules out.
IMAGE_TAG=latest

# ─── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD appears twice (standalone + embedded in DATABASE_URL)
# because Compose's env_file does not expand ${VARS} inside itself — this
# duplication is expected, not a mistake.
POSTGRES_USER=clausio
POSTGRES_PASSWORD=change-me-to-a-real-random-password
POSTGRES_DB=clausio
DATABASE_URL=postgresql://clausio:change-me-to-a-real-random-password@postgres:5432/clausio

# ─── Redis ────────────────────────────────────────────────────────────────────
# Service name, not localhost — api/workers reach it over clausio_internal.
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
# Separate from JWT_SECRET/JWT_REFRESH_SECRET on purpose — a witness has no
# User row, no organizationId, and no role, so its session token is a
# structurally different credential, not just another JWT_SECRET use.
WITNESS_SESSION_JWT_SECRET=change-me-to-a-third-long-random-secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─── OpenAI (optional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Storage / MinIO ──────────────────────────────────────────────────────────
S3_BUCKET=clausio-contracts
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
AWS_ACCESS_KEY_ID=change-me-to-a-real-random-access-key
AWS_SECRET_ACCESS_KEY=change-me-to-a-real-random-secret
MINIO_ROOT_USER=change-me-to-a-real-random-access-key
MINIO_ROOT_PASSWORD=change-me-to-a-real-random-secret

# ─── Persistent data location on the host (bind mounts) ──────────────────────
CLAUSIO_DATA_DIR=/opt/clausio/data

# ─── Workers ──────────────────────────────────────────────────────────────────
# Lowered from the dev default (3) — this VPS has 1 GB RAM total; parsing
# concurrent large files is the single most likely source of memory pressure.
EXTRACTION_CONCURRENCY=1
