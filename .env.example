# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Base URL of the web app, used to build links in outgoing emails (e.g. the
# invitation email's registerUrl — packages/api/src/services/invitation.service.ts).
APP_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onrampproject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onrampproject
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Used by the workers package to send invitation emails (packages/workers/src/jobs/email.job.ts).
RESEND_API_KEY=
EMAIL_FROM=

# ─── AI Platform (OpenRouter) ─────────────────────────────────────────────────
OPENROUTER_API_KEY=
AI_DEFAULT_MODEL=openai/gpt-4o-mini

# ─── Storage / S3 (optional) ──────────────────────────────────────────────────
S3_BUCKET=clausio-contracts
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Workers ──────────────────────────────────────────────────────────────────
# Production (.env.prod) lowers this — see .env.prod.example.
EXTRACTION_CONCURRENCY=3
AI_ANALYSIS_CONCURRENCY=2