# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/

# packages/shared's source dirs are TS-only; a stray `tsc` run without
# --project tsconfig.build.json emits compiled output next to the source
# instead of into dist/. Never legitimate to commit.
packages/shared/ai/*.js
packages/shared/ai/*.js.map
packages/shared/ai/*.d.ts
packages/shared/auth/*.js
packages/shared/auth/*.js.map
packages/shared/auth/*.d.ts
packages/shared/db/**/*.js
packages/shared/db/**/*.js.map
packages/shared/db/**/*.d.ts
packages/shared/queue/*.js
packages/shared/queue/*.js.map
packages/shared/queue/*.d.ts
packages/shared/src/*.js
packages/shared/src/*.js.map
packages/shared/src/*.d.ts

# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod

# ─── Reverse proxy — Let's Encrypt runtime state ───────────────────────────────
# Certificates, private keys, account keys, and all other ACME state are
# generated at deploy time (see reverse-proxy/DEPLOYMENT.md) and must never
# be committed. Keep the directory skeleton via .gitkeep so a fresh clone
# has somewhere for certbot/nginx to mount into.
reverse-proxy/certbot/conf/*
reverse-proxy/certbot/www/*
!reverse-proxy/certbot/conf/.gitkeep
!reverse-proxy/certbot/www/.gitkeep

# ─── Turborepo ────────────────────────────────────────────────────────────────
.turbo/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Coverage ─────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── AI assistant configuration (local-only, not project documentation) ───────
CLAUDE.md
AGENTS.md
report.md

home