{
  "name": "@starter-kit/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-prompts.js",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.ts'",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "eval": "dotenv -e ../../.env -- tsx scripts/run-eval.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.67.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  }
}
